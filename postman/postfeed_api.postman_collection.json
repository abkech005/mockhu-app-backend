                {
                    "name": "Create Postfeed (Doubt)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"type\": \"doubt\",\n  \"title\": \"How to solve quadratic equations?\",\n  \"content\": \"I'm stuck on x² + 5x + 6 = 0. Can someone explain the steps?\",\n  \"tags\": [\"math\", \"algebra\", \"quadratic\"],\n  \"visibility\": \"public\",\n  \"metadata\": {\n    \"subject\": \"Mathematics\",\n    \"is_solved\": false\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/v1/postfeeds",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "v1",
                                "postfeeds"
                            ]
                        }
                    }
                },
