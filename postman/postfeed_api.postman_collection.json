    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8085"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "postfeed_id",
            "value": ""
        },
        {
            "key": "comment_id",
            "value": ""
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Postfeeds",
