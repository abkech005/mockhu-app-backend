{
    "info": {
        "_postman_id": "follow-service-collection",
        "name": "Follow Service",
        "description": "Collection for Follow/Unfollow endpoints. Note: Most endpoints require JWT authentication.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Follow User",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/users/:userId/follow",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "users",
                        ":userId",
                        "follow"
                    ],
                    "variable": [
                        {
                            "key": "userId",
                            "value": "11111111-1111-1111-1111-111111111111",
                            "description": "User ID to follow"
                        }
                    ]
                },
                "description": "Follow a user. Requires authentication."
            },
            "response": []
        },
        {
            "name": "Unfollow User",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/users/:userId/follow",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "users",
                        ":userId",
                        "follow"
                    ],
                    "variable": [
                        {
                            "key": "userId",
                            "value": "11111111-1111-1111-1111-111111111111",
                            "description": "User ID to unfollow"
                        }
                    ]
                },
                "description": "Unfollow a user. Requires authentication."
            },
            "response": []
        },
        {
            "name": "Get Followers",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/users/:userId/followers?limit=20&offset=0",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "users",
                        ":userId",
                        "followers"
                    ],
                    "query": [
                        {
                            "key": "limit",
                            "value": "20"
                        },
                        {
                            "key": "offset",
                            "value": "0"
                        }
                    ],
                    "variable": [
                        {
                            "key": "userId",
                            "value": "e4a02b15-aa17-4f8c-a9d1-0a47089e9f0d",
                            "description": "User ID to get followers for"
                        }
                    ]
                },
                "description": "Get list of users who follow this user"
            },
            "response": []
        },
        {
            "name": "Get Following",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/users/:userId/following?limit=20&offset=0",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "users",
                        ":userId",
                        "following"
                    ],
                    "query": [
                        {
                            "key": "limit",
                            "value": "20"
                        },
                        {
                            "key": "offset",
                            "value": "0"
                        }
                    ],
                    "variable": [
                        {
                            "key": "userId",
                            "value": "e4a02b15-aa17-4f8c-a9d1-0a47089e9f0d",
                            "description": "User ID to get following list for"
                        }
                    ]
                },
                "description": "Get list of users this user follows"
            },
            "response": []
        },
        {
            "name": "Check Is Following",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/users/:userId/is-following",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "users",
                        ":userId",
                        "is-following"
                    ],
                    "variable": [
                        {
                            "key": "userId",
                            "value": "11111111-1111-1111-1111-111111111111",
                            "description": "User ID to check if current user is following"
                        }
                    ]
                },
                "description": "Check if authenticated user is following this user"
            },
            "response": []
        },
        {
            "name": "Get Follow Stats (Public)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/users/:userId/follow-stats",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "users",
                        ":userId",
                        "follow-stats"
                    ],
                    "variable": [
                        {
                            "key": "userId",
                            "value": "e4a02b15-aa17-4f8c-a9d1-0a47089e9f0d",
                            "description": "User ID to get follow stats for"
                        }
                    ]
                },
                "description": "Get follower and following counts. No authentication required."
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8085/v1",
            "type": "string"
        },
        {
            "key": "accessToken",
            "value": "YOUR_JWT_ACCESS_TOKEN",
            "type": "string"
        }
    ]
}